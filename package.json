{
    "name": "ai-admissions-advisor",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:api": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.api.config.mts",
        "test:rls": "docker exec -i supabase_db_admissions-advisor psql -U postgres -d postgres -q < supabase/tests/rls.sql",
        "typecheck": "tsc --noEmit",
        "mock:gemini": "node --env-file-if-exists=.env.local mock/gemini-server.mts",
        "gemini:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-file-search.mts",
        "db:new": "supabase migration new",
        "db:reset": "supabase db reset",
        "db:push": "supabase db push",
        "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
        "db:diff": "supabase db diff",
        "promote:teacher": "node --env-file-if-exists=.env.local scripts/promote-teacher.mts"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@google/genai": "^2.19.0",
        "@shadcn/react": "^0.3.0",
        "@supabase/ssr": "^0.12.5",
        "@supabase/supabase-js": "^2.112.4",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "5.102.8",
        "@tanstack/react-table": "^9.2.4",
        "@tanstack/react-virtual": "^3.14.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.37.0",
        "next": "16.3.3",
        "next-intl": "^4.14.1",
        "next-themes": "^0.4.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "server-only": "^0.0.1",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.3",
        "prettier": "3.9.6",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "4.1.11"
    }
}
