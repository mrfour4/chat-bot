# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_…). Safe in the browser; RLS protects data.
# Legacy projects: NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). SERVER ONLY — bypasses RLS. Never expose.
# Legacy projects: SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Gemini — https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Model used to answer admissions questions.
# D7 (§5.13): 3.6, not the newer 3.7, which returned 503 for ~75s straight
# during 2.1.0 while 3.6 answered first try. Newest is not most available.
GEMINI_MODEL=gemini-3.6-flash

# File Search store holding the indexed admissions PDFs.
# Create it once with `npm run gemini:bootstrap`, then paste the value here.
# Format: fileSearchStores/xxxxxxxx
GEMINI_FILE_SEARCH_STORE=

# ---------------------------------------------------------------------------
# Background indexing (3.6) — optional
# ---------------------------------------------------------------------------
# Lets a scheduler re-drive documents whose indexing worker died, by sending
# `x-reindex-secret` to POST /api/documents/reindex. Leave empty and only a
# signed-in teacher can trigger the sweep, which the documents page already
# does while anything is in flight. Set it to any long random string.
REINDEX_SECRET=

# ---------------------------------------------------------------------------
# Mock Gemini server (5.2) — development only
# ---------------------------------------------------------------------------
# Points the real @google/genai client at `npm run mock:gemini` instead of
# Google, so the whole indexing and answering path can be exercised without
# spending free-tier quota. The SDK rewrites the resumable upload's host to
# this base, which is what makes one variable enough. Leave it empty to use
# the real API; /api/health says which one is in use.
GEMINI_BASE_URL=

# The mock's behaviour, all optional. Delay is 4s + 6s per MB, jittered ±30%
# and capped at 150s. Rates are probabilities per upload or per answer;
# MOCK_GEMINI_FAILURE_RATE scales all four at once, so 0 means never fail.
# MOCK_GEMINI_PORT=4010
# MOCK_GEMINI_FAILURE_RATE=1
# MOCK_GEMINI_ERROR_RATE=0.12
# MOCK_GEMINI_EMPTY_RATE=0.08
# MOCK_GEMINI_QUOTA_RATE=0.08
# MOCK_GEMINI_UNAVAILABLE_RATE=0.07
